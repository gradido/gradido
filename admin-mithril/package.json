{
  "name": "admin-mithril",
  "description": "Administration Interface for Gradido, rewritten in Mithril",
  "author": "Gradido Academy - https://www.gradido.net",
  "version": "3.1.7",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "uname | grep -q Linux && find build -type f -regex '.*\\.\\(html\\|js\\|css\\|svg\\|json\\)' -exec gzip -9 -k {} + || echo 'Skip precompress on non-Linux'",
    "start": "vite preview",
    "test": "bun test src",
    "test:compare": "playwright test",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --error-on-warnings . --write",
    "typecheck": "bun check && bun check -p tests"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.3",
    "graphql": "16.14.2",
    "graphql-tag": "^2.12.6",
    "mithril": "^2.2.15",
    "qrcanvas": "^3.1.2",
    "valibot": "1.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@iconify/json": "^2.2.228",
    "@playwright/test": "1.64.1",
    "@types/bootstrap": "^5.2.10",
    "@types/bun": "1.4.3",
    "@types/mithril": "^2.2.7",
    "config-schema": "*",
    "dotenv": "^16.6.1",
    "sass": "^1.77.8",
    "shared": "*",
    "unplugin-icons": "^0.19.0",
    "vite": "^5.4.14",
    "vite-plugin-environment": "^1.1.3",
    "vite-plugin-graphql-loader": "^4.0.4"
  },
  "engines": {
    "node": ">=24"
  }
}
