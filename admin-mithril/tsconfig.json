{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@admin/*": [
        "../admin/src/*"
      ]
    },
    "types": [
      "vite/client",
      "bun",
      "unplugin-icons/types/raw"
    ]
  },
  "include": [
    "src/**/*.ts"
  ]
}
