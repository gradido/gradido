{
  "extends": ["//"],
  "tasks": {
    "clear": {
      "cache": false
    },
    "clearDB": {
      "cache": false
    },
    "up:backend_test": {
      "cache": false,
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["NODE_ENV", "DB_*", "TYPEORM_*", "REDIS_URL", "DEFAULT_LANGUAGE"]
    },
    "up:federation_test": {
      "cache": false,
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["NODE_ENV", "DB_*", "TYPEORM_*", "REDIS_URL", "DEFAULT_LANGUAGE"]
    },
    "up:dht_test": {
      "cache": false,
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["NODE_ENV", "DB_*", "TYPEORM_*", "REDIS_URL", "DEFAULT_LANGUAGE"]
    },
    "up:test": {
      "cache": false,
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["NODE_ENV", "DB_*", "TYPEORM_*", "REDIS_URL", "DEFAULT_LANGUAGE"]
    },
    "up": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "test": {
      "dependsOn": ["up:test", "^build"],
      "env": ["NODE_ENV", "DB_*", "TYPEORM_*", "REDIS_URL", "DEFAULT_LANGUAGE"]
    },
    "down": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "reset": {
      "cache": false,
      "dependsOn": ["build"]
    }
  }
}