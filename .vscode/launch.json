{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "tsx",
      "name": "Database Up Debug",
      "stopOnEntry": true,
      "runtimeArgs": ["--inspect-brk", "migration/index.ts", "up"],
      "env": {
        "TZ": "UTC",
        "NODE_ENV": "development",
      },
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceFolder}/database"
    },
    {
      "type": "bun",
      "request": "launch",
      "name": "Database Debug Tests",
      "stopOnEntry": false,
      "runtimeArgs": ["--inspect-brk", "test"],
      "args": ["--filter", "*"],
      "env": {
        "TZ": "UTC",
        "NODE_ENV": "development",
        "DB_DATABASE": "gradido_test"
      },
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceFolder}/database"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "DHT-Node Debug Tests",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--inspect-brk",
        "node_modules/.bin/jest",
        "--bail",
        "--runInBand",
        "--forceExit",
        "--detectOpenHandles"
      ],
      "env": {
        "TZ": "UTC",
        "NODE_ENV": "development",
        "DB_DATABASE": "gradido_test_dht"
      },
      "skipFiles": [
        "<node_internals>/**"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceFolder}/dht-node"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "DHT-Node Debug",
      "stopOnEntry": true,
      "runtimeExecutable": "tsx",
      "runtimeArgs": [
        "--inspect-brk",
        "src/index.ts"
      ],
      "env": {
        "TZ": "UTC",
        "NODE_ENV": "development"
      },
      "skipFiles": [
        "<node_internals>/**"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "openOnSessionStart",
      "cwd": "${workspaceFolder}/dht-node"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Federation Debug Tests",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--inspect-brk",
        "../node_modules/.bin/jest",
        "--bail",
        "--runInBand",
        "--forceExit",
        "--detectOpenHandles"
      ],
      "env": {
        "TZ": "UTC",
        "NODE_ENV": "development",
        "DB_DATABASE": "gradido_test_federation"
      },
      "skipFiles": [
        "<node_internals>/**"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceFolder}/federation"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Federation Debug",
      "stopOnEntry": true,
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--inspect-brk",
        "-r",
        "tsconfig-paths/register",
        "-r",
        "ts-node/register",
        "src/index.ts"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "openOnSessionStart",
      "cwd": "${workspaceFolder}/federation"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Backend Debug",
      "stopOnEntry": true,
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--inspect-brk",
        "-r",
        "tsconfig-paths/register",
        "-r",
        "ts-node/register",
        "src/index.ts"
      ],
      "env": {
        "TZ": "UTC",
        "NODE_ENV": "development"
      },
      "skipFiles": [
        "<node_internals>/**"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "openOnSessionStart",
      "cwd": "${workspaceFolder}/backend",
      "restart": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Backend Debug Tests",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--inspect-brk",
        "../node_modules/.bin/jest",
        "--bail",
        "--runInBand",
        "--forceExit",
        "--detectOpenHandles"
      ],
      "env": {
        "TZ": "UTC",
        "NODE_ENV": "development",
        "DB_DATABASE": "gradido_test_backend"
      },
      "skipFiles": [
        "<node_internals>/**"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceFolder}/backend"
    },
    {
      "type": "bun",
      "request": "launch",
      "name": "Shared Debug Test",
      "stopOnEntry": false,
      "runtimeArgs": [
        "--inspect-brk",
        "test"
      ],
      "internalConsoleOptions": "openOnSessionStart",
      "cwd": "${workspaceFolder}/shared"
    },
    {
      "type": "bun",
      "request": "launch",
      "name": "Core Debug Test",
      "stopOnEntry": false,
      "runtimeArgs": [
        "--inspect-brk",
        "test"
      ],
      "internalConsoleOptions": "openOnSessionStart",
      "cwd": "${workspaceFolder}/core"
    }
  ]
}