# Kept across deploys: start.sh reads these back from backend/.env.
DB_USER=$DB_USER
DB_PASSWORD=$DB_PASSWORD

# Fixed for every server.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gradido_community
# never a playground on a server
GRAPHIQL=false

# Everything else comes from deployment/bare_metal/.env: start.sh exports it, and a value in
# the environment wins over this file.
