{
  "name": "federation",
  "version": "3.1.3",
  "description": "Gradido federation module providing Gradido-Hub-Federation and versioned API for inter community communication",
  "main": "src/index.ts",
  "repository": "https://github.com/gradido/gradido/federation",
  "author": "Gradido Academy - https://www.gradido.net",
  "license": "Apache-2.0",
  "private": false,
  "scripts": {
    "build": "bun ./esbuild.config.ts && mkdirp build/templates/ && ncp ../core/build/templates build/templates",
    "start": "cross-env TZ=UTC NODE_ENV=production bun build/index.js",
    "dev": "cross-env TZ=UTC bun --hot src/index.ts",
    "typecheck": "bun check",
    "test": "cross-env TZ=UTC NODE_ENV=development DB_DATABASE=gradido_test_federation bun test --isolate",
    "test:debug": "cross-env TZ=UTC NODE_ENV=development DB_DATABASE=gradido_test_federation bun test --isolate --inspect-brk",
    "test:coverage": "cross-env TZ=UTC NODE_ENV=development DB_DATABASE=gradido_test_federation bun test --isolate --coverage",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --error-on-warnings . --write"
  },
  "dependencies": {
    "cross-env": "^7.0.3",
    "email-templates": "^10.0.1"
  },
  "devDependencies": {
    "@anatine/esbuild-decorators": "^0.2.19",
    "@apollo/server": "4.10.4",
    "@biomejs/biome": "2.5.15",
    "@elysia/apollo": "1.4.1",
    "@elysia/cors": "1.4.2",
    "@types/bun": "1.4.3",
    "@types/lodash.clonedeep": "^4.5.6",
    "@types/node": "^24.9.1",
    "@types/uuid": "^8.3.4",
    "await-semaphore": "0.1.3",
    "class-validator": "^0.14.3",
    "config-schema": "*",
    "core": "*",
    "database": "*",
    "dotenv": "^16.6.1",
    "elysia": "1.4.30",
    "elysia-helmet": "3.1.0",
    "esbuild": "^0.25.3",
    "graphql": "16.14.2",
    "graphql-request": "5.0.0",
    "graphql-scalars": "^1.25.0",
    "graphql-tag": "2.12.7",
    "lodash.clonedeep": "^4.5.0",
    "log4js": "^6.7.1",
    "mkdirp": "^3.0.1",
    "ncp": "^2.0.0",
    "nodemon": "^2.0.7",
    "prettier": "^3.5.3",
    "redis-semaphore": "^5.6.2",
    "reflect-metadata": "^0.1.13",
    "shared": "*",
    "source-map-support": "^0.5.21",
    "type-graphql": "2.0.0-rc.3",
    "typeorm": "^0.3.25",
    "uuid": "8.3.2",
    "valibot": "1.1.0"
  },
  "nodemonConfig": {
    "ignore": [
      "**/*.test.ts"
    ]
  },
  "engines": {
    "node": ">=24"
  }
}
