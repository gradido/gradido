{
  "name": "frontend-mithril",
  "description": "The Gradido wallet, rewritten in Mithril",
  "author": "Gradido Academy - https://www.gradido.net",
  "version": "3.2.1",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "uname | grep -q Linux && find build -type f -regex '.*\\.\\(html\\|js\\|css\\|svg\\|json\\)' -exec gzip -9 -k {} + || echo 'Skip precompress on non-Linux'",
    "start": "vite preview",
    "test": "bun test --isolate src",
    "test:compare": "playwright test",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --error-on-warnings . --write",
    "typecheck": "bun check && bun check -p tests"
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "clipboard-polyfill": "^4.0.0-rc1",
    "graphql": "16.14.2",
    "graphql-tag": "^2.12.6",
    "mithril": "^2.2.15",
    "valibot": "1.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@iconify-json/bi": "^1.1.23",
    "@iconify-json/fa": "^1.2.1",
    "@iconify-json/humbleicons": "^1.2.6",
    "@iconify-json/ion": "^1.2.2",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/tabler": "^1.2.0",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.3",
    "@types/mithril": "^2.2.7",
    "config-schema": "*",
    "dotenv": "^16.6.1",
    "lightningcss": "^1.30.1",
    "purgecss": "9.1.0",
    "sass": "1.83.4",
    "shared": "*",
    "unplugin-icons": "^0.19.1",
    "vite": "^5.4.14",
    "vite-plugin-commonjs": "^0.10.1",
    "vite-plugin-environment": "^1.1.3",
    "vite-plugin-graphql-loader": "^4.0.4",
    "vite-plugin-html": "^3.2.2"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "engines": {
    "node": ">=24"
  }
}
