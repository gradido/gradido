.{
    .name = .shared_native,
    .version = "0.1.0",
    .fingerprint = 0xa3701f833801cf96,
    .minimum_zig_version = "0.15.1",
    .dependencies = .{
        // The build template, kept in sync by `c-cpp-zig-build`.
        // Add your own dependencies here with `zig fetch --save <url>`.
        .c_cpp_zig_build = .{ .path = ".zig-native" },
        // master of gradido-blockchain-core, pinned by commit
        .blockchain_core = .{
            .url = "git+https://github.com/gradido/gradido-blockchain-core.git#aca10e30a978abb51ba0574d2a24d2333c17be2d",
            .hash = "blockchain_core-0.21.0-r94uppITLQD4kme7NhqBcl1CLQ2oFCY5VP5lMA7RP8TK",
        },
        // Must stay the version blockchain_core builds against (the .arnm entry of its own
        // build.zig.zon), or the two would compile against different layouts of the same structs.
        .arnm = .{
            .url = "https://github.com/gradido/arnm/archive/refs/tags/v0.8.3.tar.gz",
            .hash = "arnm-0.8.3-ZdhGsPZrJgAWcLD-KoYpN6RqeIjxCpEZWw1KoIdFRrU4",
        },
        // rust-image-ffi ships prebuilt objects, one archive per target. build.zig picks the
        // one for the target it builds; to move to another release, change the version in every
        // url and take the new hashes from `zig fetch <url>`. Its ABI is not stable: read its
        // CHANGELOG.md and adapt napi/image.cpp where it says so.
        // Windows takes gnullvm, not msvc: zig builds for the gnu ABI and brings LLVM's libunwind.
        .rust_image_ffi_x86_64_linux_gnu = .{
            .url = "https://github.com/gradido/rust-image-ffi/releases/download/v0.2.1/rust-image-ffi-0.2.1-x86_64-unknown-linux-gnu.tar.gz",
            .hash = "N-V-__8AAGycKwDbCJyxz7dffj2VazsWy3xCbSgvdLnP7Ad5",
            .lazy = true,
        },
        .rust_image_ffi_aarch64_linux_gnu = .{
            .url = "https://github.com/gradido/rust-image-ffi/releases/download/v0.2.1/rust-image-ffi-0.2.1-aarch64-unknown-linux-gnu.tar.gz",
            .hash = "N-V-__8AAIQYKgBq2o0gIlHvDkLXAZHqkLaiXDUnaqMcOg5z",
            .lazy = true,
        },
        .rust_image_ffi_x86_64_linux_musl = .{
            .url = "https://github.com/gradido/rust-image-ffi/releases/download/v0.2.1/rust-image-ffi-0.2.1-x86_64-unknown-linux-musl.tar.gz",
            .hash = "N-V-__8AAOWkKwAVhETgCvirrTiajnf-aWVAbAn0uD-SIX6S",
            .lazy = true,
        },
        .rust_image_ffi_aarch64_linux_musl = .{
            .url = "https://github.com/gradido/rust-image-ffi/releases/download/v0.2.1/rust-image-ffi-0.2.1-aarch64-unknown-linux-musl.tar.gz",
            .hash = "N-V-__8AALUuKgDh4ge2FwjOR_ELnP18lwLmX5wpn2GiKzaC",
            .lazy = true,
        },
        .rust_image_ffi_x86_64_macos = .{
            .url = "https://github.com/gradido/rust-image-ffi/releases/download/v0.2.1/rust-image-ffi-0.2.1-x86_64-apple-darwin.tar.gz",
            .hash = "N-V-__8AAKI9JQCu8cFo9fnLocV7Nc_SOaY_O8kJJZzQJvN-",
            .lazy = true,
        },
        .rust_image_ffi_aarch64_macos = .{
            .url = "https://github.com/gradido/rust-image-ffi/releases/download/v0.2.1/rust-image-ffi-0.2.1-aarch64-apple-darwin.tar.gz",
            .hash = "N-V-__8AAMLvIQBBazxjIJ2KrNkQEcssnCSIAn9PeK_srKAn",
            .lazy = true,
        },
        .rust_image_ffi_x86_64_windows = .{
            .url = "https://github.com/gradido/rust-image-ffi/releases/download/v0.2.1/rust-image-ffi-0.2.1-x86_64-pc-windows-gnullvm.tar.gz",
            .hash = "N-V-__8AAN-8jwCrT0lle8ixc8RRnNw9vbZjrl73KhSFdE0c",
            .lazy = true,
        },
        .rust_image_ffi_aarch64_windows = .{
            .url = "https://github.com/gradido/rust-image-ffi/releases/download/v0.2.1/rust-image-ffi-0.2.1-aarch64-pc-windows-gnullvm.tar.gz",
            .hash = "N-V-__8AANPKigDcztolgHykiB-7Xb133pXZ5gELS8NF86__",
            .lazy = true,
        },
    },
    .paths = .{ "build.zig", "build.zig.zon", "napi" },
}
