{
  "name": "shared-native",
  "version": "3.1.0",
  "description": "Gradido Shared Native Code, Low-Level Shared Code logic from blockchain rewritten in C",
  "main": "./index.cjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.cjs",
      "require": "./index.cjs"
    }
  },
  "repository": "https://github.com/gradido/gradido/shared-native",
  "author": "Gradido Academy - https://www.gradido.net",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "build": "c-cpp-zig-build",
    "build:debug": "c-cpp-zig-build --debug",
    "build:clean": "c-cpp-zig-build clean",
    "info": "c-cpp-zig-build info",
    "test": "bun test",
    "test:node": "node --test",
    "test:debug": "bun test --inspect-brk",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --error-on-warnings . --write"
  },
  "zigNative": {
    "optimize": "small",
    "napiVersion": 8
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "c-cpp-zig-build": "0.3.0",
    "decimal.js-light": "^2.5.1"
  },
  "dependencies": {},
  "engines": {
    "node": ">=24"
  }
}
