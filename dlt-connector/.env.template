# Database: the backend's database under the names this module uses. DB_USER and DB_PASSWORD
# are kept across deploys, start.sh reads them back from backend/.env.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=$DB_USER
MYSQL_PASSWORD=$DB_PASSWORD
MYSQL_DATABASE=gradido_community

# Everything else comes from deployment/bare_metal/.env: start.sh exports it, and a value in
# the environment wins over this file.
