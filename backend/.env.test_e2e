# Server
JWT_EXPIRES_IN=2m
BACKEND_PORT=4000

GDT_ACTIVE=false
HUMHUB_ACTIVE=false
GMS_ACTIVE=false

# Email
EMAIL=true
EMAIL_TEST_MODUS=false
EMAIL_TLS=false
