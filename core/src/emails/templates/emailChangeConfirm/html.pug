//- AI-GENERATED — not an architecture reference
extends ../layout.pug

block content
  h2= t('emails.emailChangeConfirm.title')
  .text-block
    include ../includes/salutation.pug
    p= t('emails.emailChangeConfirm.youAskedFor')
  .content
    h2= t('emails.emailChangeConfirm.title')
    div(class="p_content")= t('emails.emailChangeConfirm.pleaseConfirm')
    a.button-3(href=confirmLink) #{t('emails.emailChangeConfirm.confirm')}
    div(class="p_content")= t('emails.general.orCopyLink')

    a.clink(href=confirmLink) #{confirmLink}

    //- The window may be set below an hour; then there are no hours to name.
    if timeDurationObject.hours
      div(class="p_content")= t('emails.emailChangeConfirm.validity', { hours: timeDurationObject.hours })
    else
      div(class="p_content")= t('emails.emailChangeConfirm.validityMinutes', { minutes: timeDurationObject.minutes })
    div(class="p_content")= t('emails.emailChangeConfirm.notYou')
