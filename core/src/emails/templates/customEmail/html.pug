extend ../layout.pug

block content
  .text-block
    include ../includes/salutation.pug
    p
      = t('emails.customEmail.haveReceivedMessageFrom', { senderAlias })

  .subject-block
    div(class="p_content human-text")= subject

  .memo-block
    div(class="p_content human-text")= memo
    //- Green sits inside the card because that is where it is seen; the gold button
        below only offers the way into the account. Before, the single gold button led
        to the send form while saying "to account" - the label lied about its target.
    if senderCommunityUuid && senderUuid
      .child-right
        a.button-5(href=`${communityURL}/send/${senderCommunityUuid}/${senderUuid}?art=email`)
          include ../includes/chatbox-icon.pug
          span #{t('emails.general.answerNow')}

  a.button-3(href=`${communityURL}/transactions`) #{t('emails.general.toAccount')}
