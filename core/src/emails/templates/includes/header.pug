header
  .head
    //- Transparent PNG, assembled from the wallet's own parts: the leaves from
    //- public/img/template/Blaetter.png and the coin plus wordmark from
    //- public/img/brand/gradido-logo.png. It carries no background of its own, so
    //- it reads the same in light and dark mode - the pixels never change, only
    //- what shows through around them. The drop shadow of the old banner is gone
    //- on purpose: a shadow drawn for a white page lightens a dark one.
    img.head-logo(
      alt="Gradido Logo"
      loading="lazy"
      src="cid:gradidoheader"
      )

      
 
