{
  "name": "admin",
  "description": "Administration Interface for Gradido",
  "main": "index.js",
  "author": "Gradido Academy - https://www.gradido.net",
  "version": "3.1.4",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite preview",
    "postbuild": "uname | grep -q Linux && find build -type f -regex '.*\\.\\(html\\|js\\|css\\|svg\\|json\\)' -exec gzip -9 -k {} + || echo 'Skip precompress on non-Linux'",
    "lint": "biome check --error-on-warnings . && eslint --max-warnings=0 --ext .json,.js,.ts,.tsx src",
    "lint:fix": "biome check --error-on-warnings . --write && eslint --max-warnings=0 --ext .json,.js,.ts,.tsx src --fix",
    "stylelint": "stylelint --max-warnings=0 'src/**/*.{css,scss}'",
    "stylelint:fix": "stylelint --max-warnings=0 'src/**/*.{css,scss}' --fix",
    "test": "cross-env TZ=UTC vitest run",
    "test:coverage": "cross-env TZ=UTC vitest run --coverage",
    "test:debug": "cross-env TZ=UTC node --inspect-brk ./node_modules/vitest/vitest.mjs",
    "test:watch": "cross-env TZ=UTC vitest",
    "typecheck": "bun check",
    "locales": "bun scripts/sortLocales.ts",
    "locales:fix": "bun scripts/sortLocales.ts --fix"
  },
  "dependencies": {
    "@iconify/json": "^2.2.228",
    "@popperjs/core": "^2.11.8",
    "@vue/apollo-composable": "^4.0.2",
    "bootstrap": "^5.3.3",
    "bootstrap-vue-next": "0.26.8",
    "date-fns": "^2.29.3",
    "graphql": "16.14.2",
    "graphql-tag": "^2.12.6",
    "identity-obj-proxy": "^3.0.0",
    "pinia": "3.0.4",
    "portal-vue": "3.0.0",
    "qrcanvas": "^3.1.2",
    "qrcanvas-vue": "3.0.0",
    "regenerator-runtime": "^0.13.9",
    "unplugin-icons": "^0.19.0",
    "valibot": "1.1.0",
    "vite": "^5.4.14",
    "vite-plugin-commonjs": "^0.10.1",
    "vue": "3.5.13",
    "vue-i18n": "9.13.1",
    "vue-router": "4.4.0",
    "vue3-datepicker": "^0.4.0",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@apollo/client": "^3.10.8",
    "@biomejs/biome": "2.5.15",
    "@intlify/eslint-plugin-vue-i18n": "^1.4.0",
    "@typescript-eslint/parser": "8.67.0",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "@vitest/coverage-v8": "^2.0.5",
    "@vue/test-utils": "^2.4.6",
    "config-schema": "*",
    "cross-env": "^7.0.3",
    "dotenv": "^16.6.1",
    "eslint": "8.57.1",
    "jsdom": "^25.0.0",
    "lightningcss": "^1.30.1",
    "mock-apollo-client": "^1.2.1",
    "sass": "^1.77.8",
    "stylelint": "^16.19.1",
    "stylelint-config-standard-scss": "^14.0.0",
    "vite-plugin-environment": "^1.1.3",
    "vite-plugin-graphql-loader": "^4.0.4",
    "vitest": "^2.0.5",
    "vitest-canvas-mock": "^0.3.3"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "resolutions": {
    "strip-ansi": "6.0.1",
    "string-width": "4.2.2",
    "wrap-ansi": "7.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
